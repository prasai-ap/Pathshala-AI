# Environment Configuration
ENV=development

# Backend
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Frontend
FRONTEND_URL=http://localhost:8501

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=pathshala-secret-key

# LLM Configuration (OpenAI-compatible / AMD vLLM)
# Base URL for your AMD Developer Cloud vLLM endpoint (OpenAI-compatible path)
LLM_BASE_URL=http://YOUR_AMD_CLOUD_IP:8000/v1
# API key for the LLM endpoint
LLM_API_KEY=dummy
# Model identifier to request from the vLLM endpoint
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# AMD MI300X Configuration (for future use)
# GPU_DEVICE_ID=0
# ENABLE_GPU_ACCELERATION=false

# Database
DATABASE_URL=sqlite:///./test.db

# Logging
LOG_LEVEL=INFO
